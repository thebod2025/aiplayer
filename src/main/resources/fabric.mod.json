{
	"schemaVersion": 1,
	"id": "aiplayer",
	"version": "${version}",
	"name": "AI Player",
	"description": "AI-controlled player entities that survive alongside you: mining, chopping, exploring, running vanilla and mod commands, moving like real players (swimming, ladders, bridging), melee and ranged PvP, crystal PvP, auto-equip, hunting and eating, chat, and TACZ / Create compatibility.",
	"authors": [
		"thebod2025"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/aiplayerawa",
		"sources": "https://github.com/thebod2025/aiplayer",
		"issues": "https://github.com/thebod2025/aiplayer/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/aiplayer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.aiplayer.AiPlayerMod"
		],
		"client": [
			"com.aiplayer.client.AiPlayerClient"
		],
		"modmenu": [
			"com.aiplayer.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "aiplayer.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.163.0"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/aiplayerawa",
				"modmenu.github": "https://github.com/thebod2025/aiplayer"
			}
		}
	}
}